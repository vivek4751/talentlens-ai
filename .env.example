# Copy this file to .env for local development.
# On Vercel, set these under Project Settings -> Environment Variables instead.

# PostgreSQL connection string with the pgvector extension enabled.
# Example (Neon): postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@localhost:5432/talentlens_db?schema=public"

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="your_google_gemini_api_key"

# NextAuth v5 JWT signing secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_jwt_secret"

# Required in production so NextAuth knows its own canonical URL.
# Example: https://talentlens-ai.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Optional Google OAuth. If both values are present, the Google sign-in button appears.
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Production redirect URI: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"

# Signer for native Android access tokens. Generate separately from NEXTAUTH_SECRET.
# Example: openssl rand -base64 32
MOBILE_AUTH_SECRET="your_mobile_jwt_secret"
